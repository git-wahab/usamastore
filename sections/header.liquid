<script>
  document.addEventListener('DOMContentLoaded', async function () {
    const announcementBar = document.querySelector('.announcement-bar-facebook');
    const customerId = announcementBar.getAttribute('customerId');

    let facebookAccountInfo = await getFacebookAccount(customerId);

    if (facebookAccountInfo) {
      announcementBar.style.display = 'none';
    } else {
      announcementBar.style.display = 'block';
    }
  });
</script>
<div class="announcement-bar announcement-bar-facebook" style="background-color: #101010; display: none; border-bottom: 1px solid rgb(40, 40, 40);"
  customerId="{{ customer.id }}">
  <a href="/account" id="facebook-authorization-bar" class="announcement-bar__link link link--text focus-inset animate-arrow">
    <div class="page-width" style="color: white; display: flex; justify-content: center; align-items: center;">
      <p class="announcement-bar__message h5" id="" style="color: white;">
        FINALLY! Automatic invoicing on FACEBOOK!! Go HERE to activate FB authorization
        {% render 'icon-arrow' %}
      </p>
    </div>
  </a>
</div>
{%- endif -%}
{%- endif -%}

<div class="announcement-bar" style="background-color: #101010; display: none;" id="reserved-product-timer-bar">

  <a href="*" id="timer-bar-checkout-link" class="announcement-bar__link link link--text focus-inset animate-arrow">

    <div class="page-width" style="color: white; display: flex; justify-content: center; align-items: center;">
      <p class="announcement-bar__message h5" id="timer-bar-checkout-message" style="color: white;">
        <span id="total-number-of-products">You have X reserved products.</span> Your invoice has <span

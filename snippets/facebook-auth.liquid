<div id="facebook-detail" style="display: none;  align-items: center;">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    height="18px"
    width="18px"
    version="1.1"
    id="Layer_1"
    viewBox="0 0 291.319 291.319"
    xml:space="preserve"
  >
    <g>
    	<path style="fill:#3B5998;" d="M145.659,0c80.45,0,145.66,65.219,145.66,145.66c0,80.45-65.21,145.659-145.66,145.659   S0,226.109,0,145.66C0,65.219,65.21,0,145.659,0z"/>
    	<path style="fill:#FFFFFF;" d="M163.394,100.277h18.772v-27.73h-22.067v0.1c-26.738,0.947-32.218,15.977-32.701,31.763h-0.055   v13.847h-18.207v27.156h18.207v72.793h27.439v-72.793h22.477l4.342-27.156h-26.81v-8.366   C154.791,104.556,158.341,100.277,163.394,100.277z"/>
    </g>
  </svg>
  <span id="person-name" style="margin-left: 10px;line-height: 1;"></span>
</div>
<div id="FBiframeWrapper"></div>
<div
  id="delete-facebook-auth"
  style="cursor: pointer; font-size: 11px; background-color: #ce1818; color: white; box-shadow: none; padding: 2px 6px; font-weight: bold; border-radius: 4px; display: none; align-items: center; gap: 2px;"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
    <path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 6a1 1 0 0 1 .117 1.993l-.117 .007h-.081l-.919 11a3 3 0 0 1 -2.824 2.995l-.176 .005h-8c-1.598 0 -2.904 -1.249 -2.992 -2.75l-.005 -.167l-.923 -11.083h-.08a1 1 0 0 1 -.117 -1.993l.117 -.007h16z" /><path d="M14 2a2 2 0 0 1 2 2a1 1 0 0 1 -1.993 .117l-.007 -.117h-4l-.007 .117a1 1 0 0 1 -1.993 -.117a2 2 0 0 1 1.85 -1.995l.15 -.005h4z" />
  </svg>
  <span>Remove facebook authorization</span>
</div>

<style>
  #FBiframeWrapper .facebook-authorize-button {
    cursor: pointer;
    font-size: 13px;
    font-weight: bold;
    color: white;
    background-color: #1877f2;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
  }
</style>

<script>
  const customerIdMetaTag = document.querySelector('meta[name="customer-id"]');
  const customerId = customerIdMetaTag.getAttribute('data-customer-id');
  const deleteFacebookAuthButton = document.getElementById('delete-facebook-auth');
  const FACEBOOK_APP_ID = '3678933285602039';
  const FACEBOOK_API_VERSION = 'v26.0';

  deleteFacebookAuthButton.addEventListener('click', async () => {
    deleteFacebookAuthButton.disabled = true;
    deleteFacebookAuthButton.innerHTML = 'Deleting...';

    try {
      let deleteAccountMessage = await deleteFacebookAccount(customerId);

      if (deleteAccountMessage) {
        showToast(deleteAccountMessage);
        localStorage.removeItem('customerName');
        // Don't send the customer straight back to Facebook after removing the link.
        sessionStorage.setItem('fbAutoAuthAttempted', '1');
        await getCurrentStatus();
      }
    } catch (error) {
      console.error('Error deleting Facebook account:', error);
      showToast('Error deleting Facebook account');
    } finally {
      deleteFacebookAuthButton.disabled = false;
      deleteFacebookAuthButton.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M20 6a1 1 0 0 1 .117 1.993l-.117 .007h-.081l-.919 11a3 3 0 0 1 -2.824 2.995l-.176 .005h-8c-1.598 0 -2.904 -1.249 -2.992 -2.75l-.005 -.167l-.923 -11.083h-.08a1 1 0 0 1 -.117 -1.993l.117 -.007h16z" />
        <path d="M14 2a2 2 0 0 1 2 2a1 1 0 0 1 -1.993 .117l-.007 -.117h-4l-.007 .117a1 1 0 0 1 -1.993 -.117a2 2 0 0 1 1.85 -1.995l.15 -.005h4z" />
      </svg>
      <span>Remove Facebook Authorization</span>
    `;
    }
  });

  async function getCurrentStatus() {
    let facebookAccountInfo;
    try {
      facebookAccountInfo = await getFacebookAccount(customerId);
    } catch (error) {
      console.error('Error fetching Facebook account:', error);
      renderAuthorizeButton(false);
      return;
    }

    if (facebookAccountInfo) {
      renderAuthorizeButton(true);
      document.getElementById('facebook-detail').style.display = 'flex';
      document.getElementById(
        'person-name'
      ).innerHTML = `<span style="font-weight: bold;">${facebookAccountInfo.facebook_name}</span>`;
      deleteFacebookAuthButton.style.display = 'flex';
      return;
    }

    document.getElementById('facebook-detail').style.display = 'none';
    deleteFacebookAuthButton.style.display = 'none';

    // Auto-authorize only once per browser session, so a cancel or removal doesn't loop.
    if (sessionStorage.getItem('fbAutoAuthAttempted') === '1') {
      renderAuthorizeButton(false);
      return;
    }
    sessionStorage.setItem('fbAutoAuthAttempted', '1');

    document.getElementById('FBiframeWrapper').innerHTML = '<span>Redirecting to Facebook…</span>';
    redirectToFacebook();
  }

  function renderAuthorizeButton(reauthorize) {
    let fbIframeWrapper = document.getElementById('FBiframeWrapper');
    let text = reauthorize ? 'Re-authorize?' : 'Authorize your account';
    fbIframeWrapper.innerHTML = `<button type="button" class="facebook-authorize-button">${text}</button>`;
    fbIframeWrapper.querySelector('button').addEventListener('click', redirectToFacebook);
  }

  function redirectToFacebook() {
    const state = Array.from(crypto.getRandomValues(new Uint8Array(16)), (byte) =>
      byte.toString(16).padStart(2, '0')
    ).join('');
    sessionStorage.setItem('fbOAuthState', state);

    const params = new URLSearchParams({
      client_id: FACEBOOK_APP_ID,
      redirect_uri: `${window.location.origin}/account`,
      response_type: 'token',
      scope: 'public_profile',
      state: state,
    });
    window.location.href = `https://www.facebook.com/${FACEBOOK_API_VERSION}/dialog/oauth?${params}`;
  }

  // Facebook sends the customer back to /account with the result in the URL hash (success) or query (cancel).
  async function handleFacebookRedirectReturn() {
    const params = new URLSearchParams(window.location.hash.substring(1) || window.location.search);
    if (!params.has('state') || (!params.has('access_token') && !params.has('error'))) {
      return;
    }

    history.replaceState(null, '', window.location.pathname);
    const expectedState = sessionStorage.getItem('fbOAuthState');
    sessionStorage.removeItem('fbOAuthState');

    if (params.has('error')) {
      showToast('Facebook authorization was cancelled', 'error');
      return;
    }

    if (!expectedState || params.get('state') !== expectedState) {
      showToast('Facebook authorization failed', 'error');
      return;
    }

    const response = await fetch(
      `https://graph.facebook.com/${FACEBOOK_API_VERSION}/me?fields=id,name&access_token=${encodeURIComponent(
        params.get('access_token')
      )}`
    );
    const userInfo = await response.json();
    if (!response.ok || !userInfo.id) {
      throw new Error('Failed to fetch Facebook profile.');
    }

    await saveFacebookAccount(userInfo.name, customerId, userInfo.id);
    showToast('Facebook authorization successful');
  }

  (async function initFacebookAuth() {
    try {
      await handleFacebookRedirectReturn();
    } catch (error) {
      console.error('Error completing Facebook authorization:', error);
      showToast('Facebook authorization failed', 'error');
    }
    await getCurrentStatus();
  })();

  async function deleteFacebookAccount(shopifyId) {
    try {
      const response = await fetch(`${RESERVE_PRODUCT_BASE_URL}/api/customer`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({ shopify_id: shopifyId }),
      });

      if (response.status === 404) {
        return null;
      } else if (!response.ok) {
        throw new Error('Failed to delete Facebook account.');
      }

      // Instead of returning null, we return the message or handle the successful deletion
      const responseData = await response.json();
      return responseData.message; // You can return the success message
    } catch (error) {
      console.error('Error deleting Facebook account:', error);
      throw error;
    }
  }

  async function saveFacebookAccount(name, shopify_id, facebook_id) {
    console.log('baseUrl', `${RESERVE_PRODUCT_BASE_URL}`);
    console.log('name', name);
    const response = await fetch(`${RESERVE_PRODUCT_BASE_URL}/api/customer`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json',
      },
      body: JSON.stringify({
        shopify_id: shopify_id,
        facebook_id: facebook_id,
        name: name,
      }),
    });
    if (!response.ok) {
      throw new Error('Failed to save Facebook account.');
    }
    const json = await response.json();
    return json.data;
  }
</script>
